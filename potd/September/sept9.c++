class Solution {
public:
    long long countCommas(long long n) {
        long long count=0;
        if(n<1000) return 0;
        if(n>=1000 && n<1000000) count=(n-1000)+1;
        if(n>=1000000 && n<1000000000) count=((n-1000000)+1)*2+((1000000-1000)*1);
        if(n>=1000000000 && n<1000000000000) count=((n-1000000000)+1)*3+((1000000000-1000000)*2)+((1000000-1000)*1);
        if(n>=1000000000000 && n<1000000000000000) count=((n-1000000000000)+1)*4+(1000000000000-1000000000)*3+((1000000000-1000000)*2)+(1000000-1000)*1;
        if(n>=1000000000000000) count=((n-1000000000000000)+1)*5+(1000000000000000-1000000000000)*4+(1000000000000-1000000000)*3+((1000000000-1000000)*2)+((1000000-1000)*1);
        return count;
    }
};